# MLflow tracking server + model registry. Runs, registry (SQLite) and model
# artifacts are stored under /mlflow, which docker-compose puts on a volume.
FROM python:3.12-slim

RUN pip install --no-cache-dir mlflow==3.17.2

EXPOSE 5000
CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--artifacts-destination", "/mlflow/artifacts", \
     "--host", "0.0.0.0", "--port", "5000", \
     "--allowed-hosts", "mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1,127.0.0.1:5000"]
